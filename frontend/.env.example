# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth client ID (same as backend GOOGLE_CLIENT_ID). Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Shown on the Help & Support page
VITE_SUPPORT_EMAIL=support@resolvehub.example

# One-click demo logins on the login page (set to "false" to hide them)
VITE_DEMO_MODE=true
VITE_DEMO_PASSWORD=Demo@1234
