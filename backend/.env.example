# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://localhost:27017/resolvehub

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Frontend URL(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# Gmail address + App Password for OTP emails.
# Leave empty in development: OTPs are printed to the server console.
EMAIL_USER=
EMAIL_PASS=
OTP_EXPIRY_MINUTES=5

# Set to "false" to allow signup without email OTP (development only)
REQUIRE_EMAIL_VERIFICATION=true

# Google Sign-In (OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Cloudinary (optional). If empty, evidence is stored in backend/uploads.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed script (npm run seed)
SEED_PASSWORD=Demo@1234
SEED_ADMIN_EMAIL=admin@resolvehub.example
